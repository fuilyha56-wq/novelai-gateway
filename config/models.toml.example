# ============================================
# NovelAI Gateway 模型配置
# ============================================
# 复制本文件为 models.toml 并按需修改。
# 启动时如果 models.toml 不存在，网关会自动从本文件复制一份。

# ============================================
# 全局开关
# ============================================
# 缺失时: image_enabled 默认 true, chat_enabled/tts_enabled 默认 false
image_enabled = true
# 仅当共享 NovelAI 凭据具备文本模型权限时开启。
# 启用后请保留实际订阅/API Key 可以访问的 [[chat.models]] 条目。
chat_enabled = false
tts_enabled = false

# ============================================
# 图像模型
# ============================================
[[image.models]]
type = "image"
model_identifier = "nai-v4.5-full"
name = "nai-diffusion-4-5-full"

[[image.models]]
type = "image"
model_identifier = "nai-v4.5-curated"
name = "nai-diffusion-4-5-curated"

[[image.models]]
type = "image"
model_identifier = "nai-v4.5-inpaint"
name = "nai-diffusion-4-5-full-inpainting"

# ── 限制版（-limit 后缀，不允许消耗 Anlas）──
# 仅允许 Opus 免费边界内的生成，任一超出 → HTTP 400：
#   - n_samples = 1
#   - steps ≤ 28
#   - width*height ≤ 1048576
#   - action 为 generate / img2img / infill
#   - 无精密参考，Vibe 最多四张且全部为已编码数据
#   - service_tier ≠ priority
# 在统一生成入口及各生成别名生效。付费工具、原始 Vibe 编码等会拒绝。
# -limit 不代表下游销售价为零；usage 与价格配置见 README.md。
[[image.models]]
type = "image"
model_identifier = "nai-v4.5-full-limit"
name = "nai-diffusion-4-5-full"

[[image.models]]
type = "image"
model_identifier = "nai-v4.5-curated-limit"
name = "nai-diffusion-4-5-curated"

[[image.models]]
type = "image"
model_identifier = "nai-v4.5-inpaint-limit"
name = "nai-diffusion-4-5-full-inpainting"

# ── V5 系列（nai-diffusion-5-*，params_version=4）──
# 生成估算倍率为 1.5；销售单价由下游决定，见 README.md。
# 默认 V5 全局每日 190、滚动 7 天 1730 张，可通过环境变量调整。
[[image.models]]
type = "image"
model_identifier = "nai-v5-full"
name = "nai-diffusion-5-full"

[[image.models]]
type = "image"
model_identifier = "nai-v5-curated"
name = "nai-diffusion-5-curated"

[[image.models]]
type = "image"
model_identifier = "nai-v5-inpaint"
name = "nai-diffusion-5-full-inpainting"

[[image.models]]
type = "image"
model_identifier = "nai-v5-full-medium"
name = "nai-diffusion-5-full-medium"

[[image.models]]
type = "image"
model_identifier = "nai-v5-inpaint-medium"
name = "nai-diffusion-5-full-medium-inpainting"

# ── V5 限制版（-limit 后缀，不允许消耗 Anlas）──
# 与 V4.5 -limit 规则一致；允许边界内图生图与重绘。
# 下游按次价与完整版分档计费配置见 README.md。
[[image.models]]
type = "image"
model_identifier = "nai-v5-full-limit"
name = "nai-diffusion-5-full"

[[image.models]]
type = "image"
model_identifier = "nai-v5-curated-limit"
name = "nai-diffusion-5-curated"

[[image.models]]
type = "image"
model_identifier = "nai-v5-inpaint-limit"
name = "nai-diffusion-5-full-inpainting"

[[image.models]]
type = "image"
model_identifier = "nai-v4-curated"
name = "nai-diffusion-4-curated-preview"

[[image.models]]
type = "image"
model_identifier = "nai-v3"
name = "nai-diffusion-3"

[[image.models]]
type = "image"
model_identifier = "nai-v3-furry"
name = "nai-diffusion-furry-3"

[[image.models]]
type = "image"
model_identifier = "nai-v3-inpaint"
name = "nai-diffusion-3-inpainting"

[[image.models]]
type = "image"
model_identifier = "nai-v3-furry-inpaint"
name = "nai-diffusion-furry-3-inpainting"

# ============================================
# Chat 模型 (chat_enabled=false 时不暴露)
# ============================================
# name 为 NovelAI 文本 API 内部模型标识。当前实际可用模型取决于订阅和 API Key 权限。
# 2026-04 以原生文本 API 实测，Erato 与 Kayra 可用。
[[chat.models]]
type = "chat"
model_identifier = "nai-chat-erato"
name = "llama-3-erato-v1"

[[chat.models]]
type = "chat"
model_identifier = "nai-chat-kayra"
name = "kayra-v1"

# ============================================
# TTS 模型 (tts_enabled=false 时不暴露)
# ============================================
# v1 音色预设
[[tts.models]]
type = "tts"
model_identifier = "tts0-v1-mp3"
name = "voice=0,version=v1,opus=false,seed=Aini"

[[tts.models]]
type = "tts"
model_identifier = "tts0-v1-opus"
name = "voice=0,version=v1,opus=true,seed=Aini"

[[tts.models]]
type = "tts"
model_identifier = "tts1-v1-mp3"
name = "voice=1,version=v1,opus=false,seed=Kayra"

[[tts.models]]
type = "tts"
model_identifier = "tts1-v1-opus"
name = "voice=1,version=v1,opus=true,seed=Kayra"

# v2 音色预设
[[tts.models]]
type = "tts"
model_identifier = "tts0-v2-mp3"
name = "voice=0,version=v2,opus=false,seed=Aini"

[[tts.models]]
type = "tts"
model_identifier = "tts0-v2-opus"
name = "voice=0,version=v2,opus=true,seed=Aini"
