# 图片访问基础 URL（留空则自动根据请求 Host 生成）
# 如果你有 HTTPS 反代，填写你的公网地址，例如: https://your-domain.com
IMAGE_BASE_URL=

# 可选的 LFN V2 内部图片签名服务。使用 HTTPS 或隔离的服务私网。
# 令牌需为 32–512 个可打印非空格 ASCII 字符，优先从挂载文件读取。
LFN_WATERMARK_SIGNER_URL=
LFN_WATERMARK_SIGNER_TOKEN_FILE=
LFN_WATERMARK_SIGNER_TOKEN=

# Cloudflare Tunnel Token（可选，填写后启动时自动开启隧道）
CLOUDFLARE_TUNNEL_TOKEN=

# NovelAI 共享凭据（二选一，SHARED_API_KEY 优先）
# 持久 API Key（推荐，可在 NovelAI Account Settings → API Keys 生成）
SHARED_API_KEY=
# 多 Key 轮询（可选；配置后优先于 SHARED_API_KEY）。
# 支持 JSON 数组，或逗号、分号、换行分隔。JSON 数组写入 .env 时须用单引号包裹。
# SHARED_API_KEYS='["nai-key-a","nai-key-b"]'
SHARED_API_KEYS=
# 或 Session Token（JSON 或裸串，来自浏览器 Local Storage 的 session 项）
SHARED_TOKEN=

# 下游访问密码。配置任一共享 NovelAI 凭据时必须设置；
# OpenAI 兼容客户端使用 Authorization: Bearer <此密码>。
GATEWAY_PASSWORD=

# 仅可信私网调试时可显式关闭鉴权。公网部署不要开启。
ALLOW_UNAUTHENTICATED_ACCESS=false

# 服务监听配置
HOST=0.0.0.0
PORT=31555

# 并发与冷却（直连模式以 MAX_CONCURRENT 为运行位和等待位上限）
MAX_CONCURRENT=1
# 排队超时（秒），与上游请求期限分别计算
QUEUE_TIMEOUT=300
# 账号池模式下，每个符合请求能力的独立账号各提供一个运行位和等待位。
COOLDOWN_MIN=0.5
COOLDOWN_MAX=1.0
# 生图上游可能超过 3 分钟才返回结果；上限与 LFN 的 420 秒请求期限对齐。
UPSTREAM_TIMEOUT=420

# V5 图片生成限额（默认开启；设为 false 可关闭日/周限额拦截）
V5_QUOTA_ENABLED=true
# V5 每日限额与滚动 7 天限额
V5_DAILY_LIMIT=190
V5_WEEKLY_LIMIT=1730

# 上游地址（一般保持默认，允许自托管兼容上游用于调试）
NOVELAI_BASE_URL=https://novelai.net
NOVELAI_API_URL=https://api.novelai.net
NOVELAI_IMAGE_URL=https://image.novelai.net
NOVELAI_TEXT_URL=https://text.novelai.net
